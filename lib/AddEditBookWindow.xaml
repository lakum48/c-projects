<Window x:Class="lib.AddEditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Book" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <Label Content="Title:" />
            <TextBox Name="TitleTextBox" />
            <Label Content="Author:" />
            <ComboBox Name="AuthorComboBox" DisplayMemberPath="FullName" />
            <Label Content="Genre:" />
            <ComboBox Name="GenreComboBox" DisplayMemberPath="Name" />
            <Label Content="Publish Year:" />
            <TextBox Name="PublishYearTextBox" />
            <Label Content="ISBN:" />
            <TextBox Name="ISBNTextBox" />
            <Label Content="Quantity In Stock:" />
            <TextBox Name="QuantityInStockTextBox" />
            <Button Content="Save" Click="Save_Click" Margin="5" />
        </StackPanel>
    </Grid>
</Window>