<Window x:Class="lib.ManageAuthorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Authors" Height="400" Width="600">
    <Grid>
        <DataGrid Name="AuthorsGrid" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" />
                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" />
                <DataGridTextColumn Header="Birth Date" Binding="{Binding BirthDate, StringFormat=d}" />
                <DataGridTextColumn Header="Country" Binding="{Binding Country}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10">
            <Button Content="Add Author" Click="AddAuthor_Click" Margin="5" />
            <Button Content="Edit Author" Click="EditAuthor_Click" Margin="5" />
            <Button Content="Delete Author" Click="DeleteAuthor_Click" Margin="5" />
        </StackPanel>
    </Grid>
</Window>