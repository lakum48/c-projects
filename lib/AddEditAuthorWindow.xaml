<Window x:Class="lib.AddEditAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Author" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <Label Content="First Name:" />
            <TextBox Name="FirstNameTextBox" />
            <Label Content="Last Name:" />
            <TextBox Name="LastNameTextBox" />
            <Label Content="Birth Date:" />
            <DatePicker Name="BirthDatePicker" />
            <Label Content="Country:" />
            <TextBox Name="CountryTextBox" />
            <Button Content="Save" Click="Save_Click" Margin="5" />
        </StackPanel>
    </Grid>
</Window>