<Window x:Class="Url.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Analyzer" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Список сетевых интерфейсов -->
        <ListBox x:Name="InterfaceList" Grid.Column="0" Grid.Row="1" Margin="10" SelectionChanged="InterfaceList_SelectionChanged"/>

        <!-- Информация о выбранном интерфейсе -->
        <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
            <TextBlock x:Name="InterfaceInfo" TextWrapping="Wrap" FontSize="14"/>
        </StackPanel>

        <!-- Поле для ввода URL и анализа -->
        <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
            <TextBox x:Name="UrlInput" FontSize="14" Margin="0,0,0,10"/>
            <Button Content="Анализировать URL" Click="AnalyzeUrl_Click" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock x:Name="UrlAnalysisResult" TextWrapping="Wrap" FontSize="14"/>
            <Button Content="Проверить доступность (Ping)" Click="PingHost_Click" FontSize="14" Margin="0,10,0,10"/>
            <Button Content="Получить DNS-информацию" Click="GetDnsInfo_Click" FontSize="14" Margin="0,10,0,10"/>
        </StackPanel>
    </Grid>
</Window>