@using MudBlazor
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText>@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_processing">Отмена</MudButton>
        <MudButton Color="Color.Error" OnClick="Submit" Variant="Variant.Filled" Disabled="@_processing">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Удаление...</MudText>
            }
            else
            {
                @("Удалить")
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string ContentText { get; set; } = string.Empty;
    private bool _processing;

    private async Task Submit()
    {
        try
        {
            _processing = true;
            StateHasChanged();
            await Task.Delay(100); // Небольшая задержка для анимации
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _processing = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
} 